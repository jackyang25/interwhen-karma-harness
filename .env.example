# ──────────────────────────────────────────────────────────────────────────────
# Environment variables required to run the harness.
#
# USAGE
#   Local: copy this file to `.env`, fill in real values. `.env` is gitignored.
#          Load with python-dotenv or direnv before running anything.
#   Databricks: store the same keys in a Databricks secrets scope and pull them
#               into os.environ at the top of each notebook (see notebooks/).
#
# NEVER commit a real .env to git. Only this .env.example with placeholder
# values is committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Eka Developer Platform (MedAI MCP authentication) ────────────────────────
# Long-lived API token from console.eka.care.
# Used as: Authorization: Bearer $EKA_API_TOKEN on calls to medai-tools.eka.care/mcp
EKA_API_TOKEN=

# ── HuggingFace (model + dataset access) ──────────────────────────────────────
# Generate at https://huggingface.co/settings/tokens
# Read scope is sufficient.
HF_TOKEN=

# ── Anthropic (Claude apparatus-validation run only) ──────────────────────────
# One Claude Sonnet 4.6 run on Condition B to reproduce EkaCare's 81.9%.
# Generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (fact extractor, if you use an OpenAI model for it) ───────────────
# Optional — only needed if the fact extractor uses OpenAI. Skip if using a
# different provider or a local model.
OPENAI_API_KEY=

# ── Telemetry suppression (no value to set — just keep this line) ────────────
# Some MCP / fastmcp dependencies try to POST OpenTelemetry to localhost:4318
# and spam the logs with retry warnings. Disabling is harmless.
OTEL_SDK_DISABLED=true
